{
  "name": "monad-blitz-hackathon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @monad-blitz/web dev",
    "build": "bun --filter @monad-blitz/web build",
    "lint": "bun --filter @monad-blitz/web lint",
    "typecheck": "bun --filter @monad-blitz/web typecheck"
  },
  "packageManager": "bun@1.3.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
