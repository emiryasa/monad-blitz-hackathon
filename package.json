{
  "name": "sticket",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @sticket/web dev",
    "build": "bun --filter @sticket/web build",
    "lint": "bun --filter @sticket/web lint",
    "typecheck": "bun --filter @sticket/web typecheck"
  },
  "packageManager": "bun@1.3.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
